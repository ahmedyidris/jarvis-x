#!/usr/bin/env node
const path = require('path');
const universal = require(path.join(__dirname, '../code/universal-router.js'));
const planner = require(path.join(__dirname, '../code/planner.js'));
const memory = require(path.join(__dirname, '../code/memory.js'));

const args = process.argv.slice(2);
const cmd = args[0];
const rest = args.slice(1);

(async () => {
  try {
    switch(cmd) {
      case 'ask':
        const tierMatch = rest.find(a => a.startsWith('--tier'));
        const tier = tierMatch ? tierMatch.split(' ')[1] : 'smart';
        const question = rest.filter(a => !a.startsWith('--')).join(' ');
        
        if (!question) {
          console.log('Usage: jj ask "<question>" [--tier local|fast|smart|long]');
          process.exit(1);
        }
        
        const answer = await universal.ask(question, tier);
        console.log('Answer:', answer);
        break;
        
      case 'plan':
        const goal = rest.join(' ');
        const plan = await planner.planMultiStep(goal);
        console.log('Plan:', JSON.stringify(plan, null, 2));
        break;
        
      case 'status': {
        // Was three unconditional console.log calls that inspected nothing and
        // always exited 0 -- it reported "ready" with the daemon down and the
        // kill switch pulled. See code/status.js for what it checks now.
        // It also advertised a tier named "long", which no tier table has ever
        // defined; the tiers below are read out of the router.
        const status = require(path.join(__dirname, '../code/status.js'));
        const report = await status.collect();
        console.log(rest.includes('--json')
          ? JSON.stringify(report, null, 2)
          : status.format(report));
        process.exit(status.exitCode(report));
      }

      case 'signals': {
        // The consumer for logs/trading-signals.jsonl, which app.py's
        // TradingView webhook writes and nothing read until 2026-09-25.
        // READ-ONLY BY CONSTRUCTION: code/trading-signals.js imports no
        // executor and has no path to code/paper-trading.js, asserted by its
        // own suite. CONSTITUTION.md §III still gates every proposal on a
        // human tap, and this command does not propose -- it shows Ahmed what
        // his alerts actually said, including the ones that were rejected.
        const signals = require(path.join(__dirname, '../code/trading-signals.js'));
        const result = signals.read();
        console.log(rest.includes('--json')
          ? JSON.stringify(result, null, 2)
          : signals.format(result));
        process.exit(0);
      }

      case 'content': {
        // The two gates from PLAN_5 §6.2. All logic lives in
        // code/content-cli.js so it is testable without a terminal; this
        // supplies the real pipeline and the one thing only the shim knows.
        //
        // `interactive` is computed HERE rather than read inside the module,
        // so a test can drive both answers. It is a speed bump against
        // approving from a script, not a security boundary — an agent with
        // shell access can call code/content-pipeline.js directly. The
        // module's header says so and a test pins that it keeps saying so.
        const { openPipeline } = require(path.join(__dirname, '../code/content-pipeline.js'));
        const contentCli = require(path.join(__dirname, '../code/content-cli.js'));
        const interactive = Boolean(process.stdin.isTTY && process.stdout.isTTY);
        const pipe = openPipeline();

        // `new` is the one subcommand that calls a model, so it is the one
        // async path. Everything the shim supplies is a real dependency the
        // module refuses to default: the router for `ask`, and a `research`
        // that returns the sources HE typed rather than fetching any. See
        // code/content-cli.js's runNew() header — Jarvis choosing the evidence
        // for a claim it then asks him to approve is the thing that division
        // of labour exists to prevent.
        const out = rest[0] === 'new'
          ? await contentCli.runNew(pipe, rest.slice(1), {
            interactive,
            draftFn: ({ brief, sources }) => require(path.join(__dirname, '../code/content-draft.js'))
              .draft({
                brief,
                ask: (prompt) => universal.ask(prompt, 'smart'),
                research: async () => sources,
              }),
          })
          : contentCli.run(pipe, rest, { interactive });
        console.log(out.text);
        process.exit(out.exitCode);
      }

      default:
        console.log('Commands: ask, plan, status, content, signals');
        process.exit(1);
    }
  } catch (err) {
    console.error('Error:', err.message);
    process.exit(1);
  }
})();


#!/usr/bin/env node
const agent = require('../code/agent.js');
const router = require('../code/router.js');
const lib = require('../code/lib.js');

const args = process.argv.slice(2);
const cmd = args[0];
const rest = args.slice(1);

(async () => {
  switch(cmd) {
    case 'ask':
      const question = rest.join(' ').replace(/--tier \w+/, '');
      const tier = rest.find(a => a.startsWith('--tier'))?.split(' ')[1] || 'smart';
      await router.routeByTier(question, tier);
      break;
    case 'plan':
      const goal = rest.join(' ');
      await agent.planMultiStep(goal);
      break;
    case 'status':
      console.log('✅ Jarvis running');
      break;
    default:
      console.log('Usage: jj [ask|plan|status] ...');
  }
})();

# Sentinel runs local-first against the same Ollama instance jarvis-x uses.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text

# Optional cloud fallback (leave blank to stay fully local)
ANTHROPIC_API_KEY=

# Optional API auth for /incident. Leave blank to keep today's behavior (no
# auth). If set, requests need a matching "X-Sentinel-Token" header.
SENTINEL_API_TOKEN=

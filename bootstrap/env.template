# Copy to ~/.jarvis-x/.env (mkdir -p ~/.jarvis-x first) and fill in real
# values. This file only lists the KEYS the code actually reads (grepped from
# code/ and *.py on 2026-08-14) — no real secrets are stored anywhere in this
# repo or its backups by design. ~/.jarvis-x/.env is also Read+Edit-denied in
# bootstrap/claude-settings.template.json, so an agent session can't read
# these back out even after you fill them in.

# TTS backend (ElevenLabs) — leave blank to stay 100% local (Piper/Kokoro)
ELEVENLABS_API_KEY=

# Ollama connection (defaults assumed if unset: local host, qwen2.5:3b)
OLLAMA_HOST=
OLLAMA_MODEL=

# Embedding model override
EMBED_MODEL=

# Egyptian Arabic TTS (EGTTS-V0.1) tuning — see EGTTS_RESEARCH.md
EGTTS_MODEL_DIR=
EGTTS_IDLE_TIMEOUT_SEC=
EGTTS_TRIM_SECONDS=

# JS agent-autonomy path backend selector (see code/models.js)
JX_BACKEND=

# ---
# Also recreate separately (not covered by this template, different file):
#   ~/.elevenlabs_key  — plain API key file some scripts read directly
